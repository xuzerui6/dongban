# 复制这个文件为 .env，填入你自己的值。.env 不要提交到 git。
#
# 注意：AI_API_KEY 没有 VITE_ 前缀，这是故意的。
# 带 VITE_ 前缀的变量会被打进浏览器 bundle，等于把密钥公开。
# 这两个变量只在 Node 侧的 Vite 代理中使用（见 vite.config.ts）。

# 中转站的 API 地址，必须包含到 /v1 这一级。
# 从你的中转站后台或接入文档里确认准确地址——不同站点前缀不同
# （有的用 api. 子域，有的直接主域加 /v1），填错会 404 或 401。
AI_BASE_URL=https://api.openai-next.com/v1

# 你的中转站令牌
AI_API_KEY=your_api_key_here

# 使用的模型名。这个带 VITE_ 前缀，因为它不敏感，前端需要读。
# 填你的中转站实际支持的模型。对话要求低延迟，建议用 mini/flash 一档。
VITE_AI_MODEL=gpt-4o-mini

# ── 语音合成（去掉 AI 味的关键）─────────────────────────────
# 浏览器自带的 speechSynthesis 在 Windows 上是微软慧慧那套老引擎，
# 机械感是引擎决定的，改措辞救不回来。所以优先走中转站的神经 TTS。
# 中转站不支持时会自动退回浏览器合成，功能不会断。

# 音色。OpenAI 系可选：nova / shimmer / coral / sage / alloy / fable / echo / onyx / ash
# 女声偏温暖的是 nova 和 shimmer，coral 更年轻活泼。建议都试一遍挑你喜欢的。
VITE_TTS_VOICE=nova

# TTS 模型。留空会自动按 gpt-4o-mini-tts → tts-1 顺序探测。
# gpt-4o-mini-tts 支持 instructions 参数（可以要求「别用播音腔」），效果明显更自然，
# 所以优先。如果你的中转站不支持，会自动退到 tts-1。
VITE_TTS_MODEL=
